# Optional CRM webhook. When set, every inquiry/newsletter POST is forwarded
# with source=odoobangladesh.com plus UTM and path attribution.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Public contact overrides (optional). Defaults live in src/lib/site.ts.
NEXT_PUBLIC_WHATSAPP=8801937091332

# Cloudflare Turnstile (inquiry form). Leave unset locally to skip verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for API rate limiting. Without these, a local in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
